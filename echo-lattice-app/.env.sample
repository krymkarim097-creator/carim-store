# Copy this file to .env and fill in the secret values before starting the server
# Development-friendly defaults provided where safe. Do NOT commit real secrets to version control.

# Flask settings
FLASK_APP=echo-lattice-app.app
FLASK_ENV=development
# Set to 1 in production when running behind HTTPS
USE_HTTPS=0

# Secret key for Flask sessions: set a long random value in production
SECRET_KEY=replace_with_a_random_secret_key

# Database (optional for this demo; defaults to SQLite file under data/)
# DATABASE_URL can be provided if using an external DB
DATABASE_URL=

# OAuth / Social login (fill these with values from provider dashboards)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override redirect registered in provider (must match what you register)
GOOGLE_REDIRECT=http://127.0.0.1:5000/api/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optional: override redirect registered in provider (must match what you register)
FACEBOOK_REDIRECT=http://127.0.0.1:5000/api/auth/facebook/callback

# App operational flags
ALLOW_REGISTRATION=1
ALLOW_AUTO_REGISTER=0
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=60

# Cookie configuration (set SESSION_COOKIE_SECURE=1 when using HTTPS in prod)
SESSION_COOKIE_SECURE=0
SESSION_COOKIE_SAMESITE=Lax

# Email (optional)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Notes:
# - After filling the client IDs/secrets restart the Flask server so the env vars are picked up.
# - Redirect URIs must exactly match the values registered in Google/Facebook developer consoles.
# - For local testing of OAuth with HTTPS use ngrok (recommended) or mkcert and set USE_HTTPS=1 and SESSION_COOKIE_SECURE=1.
#
# Quick ngrok workflow (recommended for testing from other devices/tablet):
# 1. Install ngrok from https://ngrok.com and login to get an auth token.
# 2. Run the Flask server locally (default http://127.0.0.1:5000).
# 3. Start a secure tunnel: ngrok http 5000
#    This will show a public HTTPS URL like https://abcd-1234.ngrok.io
# 4. Copy that HTTPS URL and set the following env var before restarting the server:
#    NGROK_URL=https://abcd-1234.ngrok.io
# 5. In your Google/Facebook developer consoles, register the redirect URIs using the ngrok URL:
#    e.g. https://abcd-1234.ngrok.io/api/auth/google/callback
#          https://abcd-1234.ngrok.io/api/auth/facebook/callback
# 6. Also update the GOOGLE_REDIRECT and FACEBOOK_REDIRECT values below to match the ngrok callback URLs.
#
# Use the NGROK_URL below (optional):
NGROK_URL=
